  "metadataSourceReview": {
    "titleDescriptionTopics": "Scope accurately describes screening, history, measurements, examination, diagnosis and monitoring; no claim of book-only derivation.",
    "sourceLabel": "NaS synthesis of current nutrition assessment guidance; current primary and official sources supplement the book with user authorization.",
    "outcomes": "ASPEN2024 screening/assessment workflow; GLIM2019/2025 and Academy/ASPEN2012 diagnosis; NICECG32 medication, dysphagia and monitoring recommendations. Pharmacist-focused plan is an educational application, not a validated instrument.",
    "referenceScope": "Fifteen distinct references have source evidence in saved receipts. Methods papers and ICU/RA sources support assessment/method limitations only; no new therapy, severity threshold or nutrition-independent causal effect claimed.",
