    {
      "id": "nutrition-assessment-007",
      "before": {
        "id": "nutrition-assessment-007",
        "question": "What is the strongest systems level quality measure for a screening program?",
        "choices": [
          "The proportion of positive screens followed by timely assessment",
          "The number of albumin tests ordered",
          "The percentage of patients given supplements",
          "The number of diagnoses entered before screening"
        ],
        "answer": 0,
        "rationale": "Follow through measures whether risk identification leads to appropriate evaluation.",
        "reviewHref": "#screening-to-assessment"
      },
      "after": {
        "id": "nutrition-assessment-007",
        "question": "Which process measure most directly shows whether positive nutrition screens lead to assessment?",
        "choices": [
          "The proportion of positive screens followed by timely assessment",
          "The number of albumin tests ordered",
          "The percentage of patients given supplements",
          "The number of diagnoses entered before screening"
        ],
        "answer": 0,
        "rationale": "Follow through measures whether risk identification leads to assessment. Completing that process does not by itself establish a patient benefit.",
        "reviewHref": "#screening-to-assessment"
      }
    },
    {
      "id": "nutrition-assessment-093",
      "before": {
        "id": "nutrition-assessment-093",
        "question": "Which missing data mechanism is most concerning when weights are absent because the sickest patients cannot be weighed?",
        "choices": [
          "Missing not at random",
          "Missing completely at random",
          "No missingness",
          "Random measurement calibration"
        ],
        "answer": 0,
        "rationale": "Missingness depends on unobserved severity and can bias estimates if treated as random.",
        "reviewHref": "#anthropometrics-body-composition"
      },
      "after": {
        "id": "nutrition-assessment-093",
        "question": "Even after accounting for recorded clinical characteristics, the probability that weight is missing depends on the unrecorded weight itself. Which missing data mechanism does this describe?",
        "choices": [
          "Missing not at random",
          "Missing completely at random",
          "No missingness",
          "Random measurement calibration"
        ],
        "answer": 0,
        "rationale": "Missing not at random means the probability of missingness still depends on the missing value after conditioning on observed data. Severe illness alone does not establish this mechanism: if recorded clinical characteristics explain missingness, it may be missing at random. The stem explicitly states dependence on the unrecorded weight.",
        "reviewHref": "#anthropometrics-body-composition"
      }
    }
  ],
